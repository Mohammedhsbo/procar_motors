# Pro Motors Backend — Environment Variables
# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=3000

# PostgreSQL (matches root docker-compose.yml)
DATABASE_URL=postgresql://promotors:promotors@localhost:5432/pro_motors_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# CORS — frontend (Vite) and optional alternate ports
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# JWT (Phase 2) — change in production
JWT_ACCESS_SECRET=dev-access-secret-change-me-32
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limiting (Phase 19). Production caps general limit at 60/min.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# File storage. "local" writes to STORAGE_LOCAL_DIR; "r2" is wired in phase 04.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads

# Cloudflare R2 / S3 (Phase 5+) — optional in Phase 0
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Job schedulers (Phase 20). Set false on extra API replicas if desired.
JOB_SCHEDULER_ENABLED=true
