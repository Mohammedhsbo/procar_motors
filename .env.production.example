# Staging / production env file TEMPLATE.
# Copy to .env.production (gitignored) and replace every SET_* value.
# Never commit real secrets.

NODE_ENV=production
API_BIND=127.0.0.1
API_PORT=3000

POSTGRES_USER=promotors
POSTGRES_PASSWORD=SET_A_STRONG_POSTGRES_PASSWORD_HERE
POSTGRES_DB=pro_motors_db

DATABASE_URL=postgresql://promotors:SET_A_STRONG_POSTGRES_PASSWORD_HERE@postgres:5432/pro_motors_db?schema=public
REDIS_URL=redis://redis:6379

CORS_ORIGINS=https://app.example.com

JWT_ACCESS_SECRET=SET_A_UNIQUE_ACCESS_SECRET_AT_LEAST_32CH
JWT_REFRESH_SECRET=SET_A_UNIQUE_REFRESH_SECRET_AT_LEAST_32CH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60

R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

JOB_SCHEDULER_ENABLED=true
BACKUP_INTERVAL_SECONDS=86400
