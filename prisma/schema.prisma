model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  nameEn         String         @map("name_en")
  nameAr         String         @map("name_ar")
  phone          String?
  email          String?
  taxId          String?        @map("tax_id")
  rating         Decimal?       @db.Decimal(3, 2)
  balance        Decimal        @default(0) @db.Decimal(14, 2)
  status         SupplierStatus @default(active)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
  @@schema("purchasing")
}

model PurchaseRequest {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  number         String
  requestedBy    String?               @map("requested_by") @db.Uuid
  status         PurchaseRequestStatus @default(draft)
  reason         String?
  quotationId    String?               @map("quotation_id") @db.Uuid
  visitId        String?               @map("visit_id") @db.Uuid
  workOrderId    String?               @map("work_order_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@index([quotationId])
  @@map("purchase_requests")
  @@schema("purchasing")
}

model PurchaseRequestItem {
  id      String  @id @default(uuid()) @db.Uuid
  prId    String  @map("pr_id") @db.Uuid
  partId  String  @map("part_id") @db.Uuid
  qty     Decimal @db.Decimal(14, 3)
  notes   String?

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
  @@schema("purchasing")
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  branchId          String              @map("branch_id") @db.Uuid
  supplierId        String              @map("supplier_id") @db.Uuid
  purchaseRequestId String?             @map("purchase_request_id") @db.Uuid
  number            String
  status            PurchaseOrderStatus @default(new)
  subtotal          Decimal             @default(0) @db.Decimal(14, 2)
  tax               Decimal             @default(0) @db.Decimal(14, 2)
  discount          Decimal             @default(0) @db.Decimal(14, 2)
  total             Decimal             @default(0) @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?             @map("created_by") @db.Uuid

  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@index([purchaseRequestId])
  @@map("purchase_orders")
  @@schema("purchasing")
}

model PurchaseOrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  poId        String  @map("po_id") @db.Uuid
  partId      String  @map("part_id") @db.Uuid
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(14, 3)
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(14, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)

  purchaseOrder PurchaseOrder       @relation(fields: [poId], references: [id], onDelete: Cascade)
  receiptItems  GoodsReceiptItem[]

  @@map("purchase_order_items")
  @@schema("purchasing")
}

model GoodsReceipt {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  poId               String    @map("po_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  warehouseId        String    @map("warehouse_id") @db.Uuid
  number             String
  status             String    @default("draft")
  receivedBy         String?   @map("received_by") @db.Uuid
  receivedAt         DateTime? @map("received_at") @db.Timestamptz(6)
  supplierInvoiceRef String?   @map("supplier_invoice_ref")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder      @relation(fields: [poId], references: [id])
  items         GoodsReceiptItem[]

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@map("goods_receipts")
  @@schema("purchasing")
}

model GoodsReceiptItem {
  id             String  @id @default(uuid()) @db.Uuid
  grnId          String  @map("grn_id") @db.Uuid
  poItemId       String  @map("po_item_id") @db.Uuid
  qtyReceived    Decimal @map("qty_received") @db.Decimal(14, 3)
  qtyRejected    Decimal @default(0) @map("qty_rejected") @db.Decimal(14, 3)
  unitCostActual Decimal? @map("unit_cost_actual") @db.Decimal(14, 2)

  goodsReceipt      GoodsReceipt      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [poItemId], references: [id])

  @@map("goods_receipt_items")
  @@schema("purchasing")
}

