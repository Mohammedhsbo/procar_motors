// ── Tire Zone ────────────────────────────────────────────────────────────
// Stock, pricing and movement live in the shared `inventory` schema (D5).
// These tables carry only what is specific to selling and fitting tires.

model TireProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// The inventory item this tire is. Stock is never tracked here.
  partId         String   @unique @map("part_id") @db.Uuid
  sku            String   @unique
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  brand          String
  pattern        String?
  width          Int
  aspectRatio    Int      @map("aspect_ratio")
  rimDiameter    Int      @map("rim_diameter")
  season         String   @default("all_season")
  speedRating    String?  @map("speed_rating")
  loadIndex      String?  @map("load_index")
  runFlat        Boolean  @default(false) @map("run_flat")
  dotWeek        String?  @map("dot_week")
  warrantyMonths Int?     @map("warranty_months")
  warrantyKm     Int?     @map("warranty_km")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  part       Part                 @relation(fields: [partId], references: [id])
  orderItems TireSalesOrderItem[]

  @@index([width, aspectRatio, rimDiameter])
  @@index([brand])
  @@map("products")
  @@schema("tireszone")
}

