// Pro Motors — Prisma schema (multi-schema PostgreSQL)
// Conventions (OQ-07): API nameEn/nameAr ↔ DB name_en/name_ar
// See docs/BACKEND_ARCHITECTURE.md §7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "promotors", "inventory", "purchasing", "finance", "ops", "uxp", "tireszone", "daily_cafe"]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserType {
  staff
  customer

  @@schema("core")
}

enum UserStatus {
  active
  suspended
  invited

  @@schema("core")
}

enum CustomerStatus {
  vip
  active
  inactive

  @@schema("core")
}

enum VisitStatus {
  waiting
  inspection
  waitingApproval
  readyForRepair
  inProgress
  waitingParts
  qualityCheck
  readyForDelivery
  completed

  @@schema("promotors")
}

enum Priority {
  low
  normal
  high
  urgent

  @@schema("promotors")
}

enum FuelType {
  petrol
  diesel
  hybrid
  electric

  @@schema("promotors")
}

enum TransmissionType {
  auto
  manual

  @@schema("promotors")
}

enum InspectionResultState {
  ok
  warning
  failed

  @@schema("promotors")
}

enum InspectionStatus {
  draft
  in_progress
  completed

  @@schema("promotors")
}

enum WorkOrderStatus {
  draft
  assigned
  in_progress
  paused
  waiting_parts
  qc
  completed
  cancelled

  @@schema("promotors")
}

enum TechnicianTaskStatus {
  pending
  assigned
  in_progress
  paused
  completed
  blocked

  @@schema("promotors")
}

enum QualityCheckStatus {
  pending
  passed
  failed

  @@schema("promotors")
}

enum InventoryTxnType {
  purchase_in
  issue
  return
  adjustment
  transfer_out
  transfer_in
  consume

  @@schema("inventory")
}

enum ReservationStatus {
  active
  released
  consumed
  cancelled

  @@schema("inventory")
}

enum StockAlertLevel {
  low
  out

  @@schema("inventory")
}

enum StockAlertStatus {
  open
  acknowledged
  closed

  @@schema("inventory")
}

enum SupplierStatus {
  active
  hold
  inactive

  @@schema("purchasing")
}

enum PurchaseRequestStatus {
  draft
  pending_approval
  approved
  ordered
  received
  cancelled

  @@schema("purchasing")
}

enum PurchaseOrderStatus {
  new
  pending_approval
  approved
  partially_received
  received
  cancelled

  @@schema("purchasing")
}

enum QuotationStatus {
  draft
  sent
  pending
  approved
  rejected
  expired
  superseded

  @@schema("finance")
}

enum QuotationItemKind {
  labor
  service
  part
  diagnostics
  other

  @@schema("finance")
}

enum ApprovalActorType {
  customer
  staff

  @@schema("finance")
}

enum ApprovalDecision {
  approve
  reject
  request_changes

  @@schema("finance")
}

enum InvoiceStatus {
  draft
  issued
  partial
  paid
  cancelled

  @@schema("finance")
}

enum PaymentMethod {
  cash
  card
  visa
  bank_transfer
  wallet
  instapay
  vodafone_cash
  other

  @@schema("finance")
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded

  @@schema("finance")
}

enum AttachmentKind {
  photo
  video
  document
  pdf

  @@schema("ops")
}

enum AttachmentPhase {
  before
  during
  after
  other

  @@schema("ops")
}

enum OutboxStatus {
  pending
  published
  failed

  @@schema("ops")
}

enum SyncOpStatus {
  pending
  applied
  conflict
  failed

  @@schema("ops")
}

// ─────────────────────────────────────────────
// CORE
// ─────────────────────────────────────────────

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  nameEn      String    @map("name_en")
  nameAr      String    @map("name_ar")
  taxId       String?   @map("tax_id")
  phone       String?
  email       String?
  logoFileId  String?   @map("logo_file_id") @db.Uuid
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  branches        Branch[]
  departments     Department[]
  users           User[]
  employees       Employee[]
  roles           Role[]
  customers       Customer[]
  systemSettings  SystemSetting[]
  auditLogs       AuditLog[]
  vehicles        Vehicle[]
  services        Service[]
  parts           Part[]
  partCategories  PartCategory[]
  suppliers       Supplier[]
  taxRates        TaxRate[]
  applications    Application[]

  @@map("organizations")
  @@schema("core")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  nameEn         String    @map("name_en")
  nameAr         String    @map("name_ar")
  address        String?
  phone          String?
  timezone       String    @default("Africa/Cairo")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  departments  Department[]
  employees    Employee[]
  userRoles    UserRole[]
  userBranches UserBranchAccess[]
  warehouses   Warehouse[]
  visits       VehicleVisit[]
  preferredBy  Customer[] @relation("PreferredBranch")
  applications BranchApplication[]

  @@unique([organizationId, code])
  @@map("branches")
  @@schema("core")
}

/// Registry of the four business applications sharing this backend:
/// promotors (workshop ERP) · uxb (car care / PPF) · tirezone (tires) · dailycup (cafe).
model Application {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  nameEn         String    @map("name_en")
  nameAr         String    @map("name_ar")
  description    String?
  baseUrl        String?   @map("base_url")
  icon           String?
  color          String?
  sortOrder      Int       @default(0) @map("sort_order")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id])
  userAccess   UserAppAccess[]
  branches     BranchApplication[]

  @@unique([organizationId, code])
  @@map("applications")
  @@schema("core")
}

/// Which applications a user may open, and which one they land on by default.
model UserAppAccess {
  userId        String   @map("user_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  isDefault     Boolean  @default(false) @map("is_default")
  status        String   @default("active")
  grantedBy     String?  @map("granted_by") @db.Uuid
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([userId, applicationId])
  @@index([applicationId])
  @@map("user_app_access")
  @@schema("core")
}

/// Which businesses actually operate at a given branch.
model BranchApplication {
  branchId      String  @map("branch_id") @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  enabled       Boolean @default(true)

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([branchId, applicationId])
  @@index([applicationId])
  @@map("branch_applications")
  @@schema("core")
}

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  code           String
  nameEn         String    @map("name_en")
  nameAr         String    @map("name_ar")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  employees    Employee[]

  @@map("departments")
  @@schema("core")
}

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  code           String?
  nameEn         String    @map("name_en")
  nameAr         String    @map("name_ar")
  phone          String?
  jobTitle       String?   @map("job_title")
  hireDate       DateTime? @map("hire_date") @db.Date
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  user         User?

  @@map("employees")
  @@schema("core")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  employeeId       String?    @unique @map("employee_id") @db.Uuid
  customerId       String?    @unique @map("customer_id") @db.Uuid
  email            String?
  username         String?
  passwordHash     String     @map("password_hash")
  userType         UserType   @map("user_type")
  status           UserStatus @default(active)
  locale           String     @default("en")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id])
  employee      Employee?          @relation(fields: [employeeId], references: [id])
  customer      Customer?          @relation(fields: [customerId], references: [id])
  roles         UserRole[]
  branches      UserBranchAccess[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  appAccess     UserAppAccess[]

  @@unique([organizationId, email])
  @@map("users")
  @@schema("core")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  key            String
  nameEn         String    @map("name_en")
  nameAr         String    @map("name_ar")
  /// Application this role belongs to; null means it spans all applications.
  applicationCode String?  @map("application_code")
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
  @@schema("core")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  resource    String
  action      String
  /// Application this permission is scoped to; null means it spans all applications.
  applicationCode String? @map("application_code")
  description String?

  roles RolePermission[]

  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model UserRole {
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("core")
}

model UserBranchAccess {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
  @@schema("core")
}

model Customer {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  code               String?
  nameEn             String         @map("name_en")
  nameAr             String         @map("name_ar")
  phone              String
  whatsapp           String?
  email              String?
  status             CustomerStatus @default(active)
  notes              String?
  preferredBranchId  String?        @map("preferred_branch_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?        @map("created_by") @db.Uuid
  updatedBy          String?        @map("updated_by") @db.Uuid
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  organization    Organization  @relation(fields: [organizationId], references: [id])
  preferredBranch Branch?       @relation("PreferredBranch", fields: [preferredBranchId], references: [id])
  user            User?
  vehicles        Vehicle[]
  visits          VehicleVisit[]
  quotations      Quotation[]
  invoices        Invoice[]
  uxpProfile      UxpProfile?
  cafeOrders      CafeOrder[]
  tireOrders      TireSalesOrder[]
  uxbJobs         UxbJob[]

  @@unique([organizationId, phone])
  @@index([nameEn])
  @@index([nameAr])
  @@map("customers")
  @@schema("core")
}

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("system_settings")
  @@schema("core")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  metadata       Json?
  requestId      String?  @map("request_id")
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
  @@schema("core")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  deviceInfo   String?   @map("device_info")
  ip           String?
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  rotatedFrom  String?   @map("rotated_from") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
  @@schema("core")
}

// ---------------------------------------------
// PROMOTORS
// ---------------------------------------------

model Vehicle {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  plate           String
  plateNormalized String            @map("plate_normalized")
  vin             String?
  engineNumber    String?           @map("engine_number")
  make            String
  model           String
  year            Int
  color           String?
  fuelType        FuelType?         @map("fuel_type")
  transmission    TransmissionType?
  mileageCurrent  Int?              @map("mileage_current")
  photoFileId     String?           @map("photo_file_id") @db.Uuid
  status          String            @default("active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?           @map("created_by") @db.Uuid
  updatedBy       String?           @map("updated_by") @db.Uuid
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  visits       VehicleVisit[]
  warranties   Warranty[]
  tireOrders   TireSalesOrder[]
  uxbJobs      UxbJob[]

  @@unique([organizationId, plateNormalized])
  @@unique([organizationId, vin])
  @@index([plateNormalized])
  @@map("vehicles")
  @@schema("promotors")
}

model VehicleVisit {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  branchId           String      @map("branch_id") @db.Uuid
  customerId         String      @map("customer_id") @db.Uuid
  vehicleId          String      @map("vehicle_id") @db.Uuid
  status             VisitStatus @default(waiting)
  priority           Priority    @default(normal)
  advisorId          String?     @map("advisor_id") @db.Uuid
  mileageIn          Int?        @map("mileage_in")
  fuelLevelPct       Int?        @map("fuel_level_pct")
  exteriorCondition  String?     @map("exterior_condition")
  complaint          String?
  expectedDeliveryAt DateTime?   @map("expected_delivery_at") @db.Timestamptz(6)
  progressPct        Int         @default(0) @map("progress_pct")
  checkedInAt        DateTime    @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(6)
  deliveredAt        DateTime?   @map("delivered_at") @db.Timestamptz(6)
  notes              String?
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?     @map("created_by") @db.Uuid
  updatedBy          String?     @map("updated_by") @db.Uuid
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)

  branch        Branch              @relation(fields: [branchId], references: [id])
  customer      Customer            @relation(fields: [customerId], references: [id])
  vehicle       Vehicle             @relation(fields: [vehicleId], references: [id])
  jobTicket     JobTicket?
  damagePoints  VisitDamagePoint[]
  inspections   Inspection[]
  workOrders    WorkOrder[]
  quotations    Quotation[]
  invoices      Invoice[]
  qualityChecks QualityCheck[]
  reservations  StockReservation[]
  cafeOrders    CafeOrder[]
  tireOrders    TireSalesOrder[]
  uxbJobs       UxbJob[]

  @@index([branchId, status])
  @@index([branchId, checkedInAt])
  @@index([vehicleId])
  @@map("vehicle_visits")
  @@schema("promotors")
}

model VisitDamagePoint {
  id       String  @id @default(uuid()) @db.Uuid
  visitId  String  @map("visit_id") @db.Uuid
  xPct     Decimal @map("x_pct") @db.Decimal(5, 2)
  yPct     Decimal @map("y_pct") @db.Decimal(5, 2)
  labelEn  String  @map("label_en")
  labelAr  String  @map("label_ar")
  severity String?

  visit VehicleVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_damage_points")
  @@schema("promotors")
}

model JobTicket {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  visitId        String   @unique @map("visit_id") @db.Uuid
  number         String
  advisorId      String?  @map("advisor_id") @db.Uuid
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid

  visit      VehicleVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
  quotations Quotation[]

  @@unique([organizationId, number])
  @@map("job_tickets")
  @@schema("promotors")
}

model InspectionTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  version        Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items        InspectionTemplateItem[]
  inspections  Inspection[]

  @@unique([organizationId, code, version])
  @@map("inspection_templates")
  @@schema("promotors")
}

model InspectionTemplateItem {
  id                  String  @id @default(uuid()) @db.Uuid
  templateId          String  @map("template_id") @db.Uuid
  category            String?
  nameEn              String  @map("name_en")
  nameAr              String  @map("name_ar")
  sortOrder           Int     @default(0) @map("sort_order")
  requiresMeasurement Boolean @default(false) @map("requires_measurement")

  template InspectionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  results  InspectionResult[]

  @@map("inspection_template_items")
  @@schema("promotors")
}

model Inspection {
  id               String            @id @default(uuid()) @db.Uuid
  visitId          String            @map("visit_id") @db.Uuid
  templateId       String            @map("template_id") @db.Uuid
  templateVersion  Int               @map("template_version")
  inspectorId      String?           @map("inspector_id") @db.Uuid
  status           InspectionStatus  @default(draft)
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  notes            String?
  estimatedTotal   Decimal?          @map("estimated_total") @db.Decimal(14, 2)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?           @map("created_by") @db.Uuid

  visit     VehicleVisit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  template  InspectionTemplate     @relation(fields: [templateId], references: [id])
  results   InspectionResult[]
  findings  InspectionFinding[]

  @@map("inspections")
  @@schema("promotors")
}

model InspectionResult {
  id              String                 @id @default(uuid()) @db.Uuid
  inspectionId    String                 @map("inspection_id") @db.Uuid
  templateItemId  String                 @map("template_item_id") @db.Uuid
  state           InspectionResultState
  note            String?
  measurement     String?
  photoFileIds    String[]               @default([]) @map("photo_file_ids") @db.Uuid

  inspection   Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem InspectionTemplateItem @relation(fields: [templateItemId], references: [id])

  @@map("inspection_results")
  @@schema("promotors")
}

model InspectionFinding {
  id                     String   @id @default(uuid()) @db.Uuid
  inspectionId           String   @map("inspection_id") @db.Uuid
  titleEn                String   @map("title_en")
  titleAr                String   @map("title_ar")
  causeEn                String?  @map("cause_en")
  causeAr                String?  @map("cause_ar")
  severity               String?
  recommendedActionEn    String?  @map("recommended_action_en")
  recommendedActionAr    String?  @map("recommended_action_ar")
  estimatedMinutes       Int?     @map("estimated_minutes")

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_findings")
  @@schema("promotors")
}

model WorkshopBay {
  id       String  @id @default(uuid()) @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  code     String
  name     String
  isActive Boolean @default(true) @map("is_active")

  workOrders WorkOrder[]

  @@unique([branchId, code])
  @@map("workshop_bays")
  @@schema("promotors")
}

model WorkOrder {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  visitId           String          @map("visit_id") @db.Uuid
  jobTicketId       String          @map("job_ticket_id") @db.Uuid
  number            String
  status            WorkOrderStatus @default(draft)
  priority          Priority        @default(normal)
  technicianId      String?         @map("technician_id") @db.Uuid
  bayId             String?         @map("bay_id") @db.Uuid
  estimatedMinutes  Int?            @map("estimated_minutes")
  actualMinutes     Int?            @map("actual_minutes")
  progressPct       Int             @default(0) @map("progress_pct")
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  parentWorkOrderId String?         @map("parent_work_order_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid

  visit           VehicleVisit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  jobTicket       JobTicket         @relation(fields: [jobTicketId], references: [id])
  bay             WorkshopBay?      @relation(fields: [bayId], references: [id])
  parent          WorkOrder?        @relation("WoTree", fields: [parentWorkOrderId], references: [id])
  children        WorkOrder[]       @relation("WoTree")
  tasks           TechnicianTask[]
  qualityChecks   QualityCheck[]
  reservations    StockReservation[]
  warranties      Warranty[]
  invoices        Invoice[]
  tireOrders      TireSalesOrder[]

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@index([technicianId])
  @@map("work_orders")
  @@schema("promotors")
}

model TechnicianTask {
  id               String               @id @default(uuid()) @db.Uuid
  workOrderId      String               @map("work_order_id") @db.Uuid
  assigneeId       String?              @map("assignee_id") @db.Uuid
  title            String
  status           TechnicianTaskStatus @default(pending)
  priority         Priority             @default(normal)
  estimatedMinutes Int?                 @map("estimated_minutes")
  elapsedSeconds   Int                  @default(0) @map("elapsed_seconds")
  startedAt        DateTime?            @map("started_at") @db.Timestamptz(6)
  pausedAt         DateTime?            @map("paused_at") @db.Timestamptz(6)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(6)
  blockedReason    String?              @map("blocked_reason")
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("technician_tasks")
  @@schema("promotors")
}

model QualityCheck {
  id          String             @id @default(uuid()) @db.Uuid
  visitId     String             @map("visit_id") @db.Uuid
  workOrderId String             @map("work_order_id") @db.Uuid
  inspectorId String?            @map("inspector_id") @db.Uuid
  status      QualityCheckStatus @default(pending)
  notes       String?
  decidedAt   DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  visit     VehicleVisit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  workOrder WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items     QualityCheckItem[]

  @@map("quality_checks")
  @@schema("promotors")
}

model QualityCheckItem {
  id             String  @id @default(uuid()) @db.Uuid
  qualityCheckId String  @map("quality_check_id") @db.Uuid
  labelEn        String  @map("label_en")
  labelAr        String  @map("label_ar")
  passed         Boolean?

  qualityCheck QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@map("quality_check_items")
  @@schema("promotors")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  code            String
  nameEn          String    @map("name_en")
  nameAr          String    @map("name_ar")
  laborPrice      Decimal   @map("labor_price") @db.Decimal(14, 2)
  durationMinutes Int       @map("duration_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("services")
  @@schema("promotors")
}

model Warranty {
  id                String    @id @default(uuid()) @db.Uuid
  vehicleId         String    @map("vehicle_id") @db.Uuid
  workOrderId       String?   @map("work_order_id") @db.Uuid
  type              String
  description       String?
  validUntil        DateTime? @map("valid_until") @db.Date
  validUntilMileage Int?      @map("valid_until_mileage")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("warranties")
  @@schema("promotors")
}

