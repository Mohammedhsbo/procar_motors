  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  make           String
  model          String
  yearFrom       Int      @map("year_from")
  yearTo         Int?     @map("year_to")
  width          Int
  aspectRatio    Int      @map("aspect_ratio")
  rimDiameter    Int      @map("rim_diameter")
  position       String   @default("all")
  isOem          Boolean  @default(true) @map("is_oem")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([make, model])
  @@index([width, aspectRatio, rimDiameter])
  @@map("fitments")
  @@schema("tireszone")
}

/// Fitting-bay services: mount, balance, alignment, puncture repair, nitrogen.
model TireService {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  price          Decimal  @db.Decimal(14, 2)
  durationMin    Int      @default(30) @map("duration_min")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems TireSalesOrderItem[]

  @@unique([organizationId, code])
  @@map("services")
  @@schema("tireszone")
}

model TireSalesOrder {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  number         String
  /// pos | workshop_request | online
  channel        String    @default("pos")
  status         String    @default("draft")
  customerId     String?   @map("customer_id") @db.Uuid
  vehicleId      String?   @map("vehicle_id") @db.Uuid
  /// Set when Pro Motors raised this from an inspection finding.
  visitId        String?   @map("visit_id") @db.Uuid
  workOrderId    String?   @map("work_order_id") @db.Uuid
  odometer       Int?
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  discount       Decimal   @default(0) @db.Decimal(14, 2)
  tax            Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  invoiceId      String?   @map("invoice_id") @db.Uuid
  notes          String?
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer?            @relation(fields: [customerId], references: [id])
  vehicle   Vehicle?             @relation(fields: [vehicleId], references: [id])
  visit     VehicleVisit?        @relation(fields: [visitId], references: [id])
  workOrder WorkOrder?           @relation(fields: [workOrderId], references: [id])
  items     TireSalesOrderItem[]
  alignment TireAlignment?

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@index([visitId])
  @@index([customerId])
  @@map("sales_orders")
  @@schema("tireszone")
}

model TireSalesOrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  /// Exactly one of productId / serviceId is set.
  productId  String?  @map("product_id") @db.Uuid
  serviceId  String?  @map("service_id") @db.Uuid
  nameEn     String   @map("name_en")
  nameAr     String   @map("name_ar")
  qty        Decimal  @default(1) @db.Decimal(14, 3)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount   Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(14, 2)
  taxRateId  String?  @map("tax_rate_id") @db.Uuid
  /// Stock reservation held until the order is completed or cancelled.
  reservationId String? @map("reservation_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")

  order    TireSalesOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  TireProduct?      @relation(fields: [productId], references: [id])
  service  TireService?      @relation(fields: [serviceId], references: [id])
  warranty TireWarranty?

  @@index([orderId])
  @@map("sales_order_items")
  @@schema("tireszone")
}

model TireWarranty {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @unique @map("order_item_id") @db.Uuid
  months      Int?
  kmLimit     Int?      @map("km_limit")
  startOdometer Int?    @map("start_odometer")
  startsAt    DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  terms       String?

  orderItem TireSalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("warranties")
  @@schema("tireszone")
}

/// Before/after alignment readings — a strong trust signal for customers.
model TireAlignment {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @unique @map("order_id") @db.Uuid
  technicianId String?  @map("technician_id") @db.Uuid
  before       Json?
  after        Json?
  notes        String?
  performedAt  DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)

  order TireSalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("alignments")
  @@schema("tireszone")
}

// ── Daily Cup — cafe operations and recipe costing ───────────────────────
// Ingredients are `inventory.parts` rows in a per-branch cafe warehouse (D5),
// so purchasing, stock movement and valuation stay in one engine.

model CafeCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products CafeProduct[]

  @@unique([organizationId, code])
  @@map("categories")
  @@schema("daily_cafe")
}

model CafeProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  description    String?
  imageFileId    String?  @map("image_file_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category CafeCategory         @relation(fields: [categoryId], references: [id])
  variants CafeProductVariant[]

  @@unique([organizationId, code])
  @@index([categoryId])
  @@map("products")
  @@schema("daily_cafe")
}

/// A sellable size. Price lives here; cost comes from the linked recipe.
model CafeProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  size      String
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  price     Decimal  @db.Decimal(14, 2)
  recipeId  String?  @map("recipe_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  product    CafeProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe     CafeRecipe?     @relation(fields: [recipeId], references: [id])
  orderItems CafeOrderItem[]

  @@unique([productId, size])
  @@map("product_variants")
  @@schema("daily_cafe")
}

/// Extra shot, oat milk, no sugar — may consume stock of its own.
model CafeModifier {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  code             String
  nameEn           String   @map("name_en")
  nameAr           String   @map("name_ar")
  priceDelta       Decimal  @default(0) @map("price_delta") @db.Decimal(14, 2)
  ingredientPartId String?  @map("ingredient_part_id") @db.Uuid
  qty              Decimal? @db.Decimal(14, 4)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ingredient Part? @relation(fields: [ingredientPartId], references: [id])

  @@unique([organizationId, code])
  @@map("modifiers")
  @@schema("daily_cafe")
}

/// A bill of materials. Cost per cup is derived from its items.
model CafeRecipe {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  yieldQty       Decimal  @default(1) @map("yield_qty") @db.Decimal(14, 4)
  yieldUnit      String   @default("unit") @map("yield_unit")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items    CafeRecipeItem[]
  variants CafeProductVariant[]

  @@unique([organizationId, code])
  @@map("recipes")
  @@schema("daily_cafe")
}

model CafeRecipeItem {
  id        String  @id @default(uuid()) @db.Uuid
  recipeId  String  @map("recipe_id") @db.Uuid
  partId    String  @map("part_id") @db.Uuid
  qty       Decimal @db.Decimal(14, 4)
  unit      String
  /// Expected loss as a fraction, e.g. 0.02 for 2% grinding loss.
  wastePct  Decimal @default(0) @map("waste_pct") @db.Decimal(6, 4)
  sortOrder Int     @default(0) @map("sort_order")

  recipe CafeRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  part   Part       @relation(fields: [partId], references: [id])

  @@unique([recipeId, partId])
  @@map("recipe_items")
  @@schema("daily_cafe")
}

model CafeOrder {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  number         String
  /// dine_in | takeaway | waiting_area — waiting_area links to a live visit.
  type           String    @default("takeaway")
  status         String    @default("open")
  customerId     String?   @map("customer_id") @db.Uuid
  visitId        String?   @map("visit_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.Uuid
  tableRef       String?   @map("table_ref")
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  discount       Decimal   @default(0) @db.Decimal(14, 2)
  tax            Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  costTotal      Decimal   @default(0) @map("cost_total") @db.Decimal(14, 4)
  invoiceId      String?   @map("invoice_id") @db.Uuid
  employeeId     String?   @map("employee_id") @db.Uuid
  readyAt        DateTime? @map("ready_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer?        @relation(fields: [customerId], references: [id])
  visit    VehicleVisit?    @relation(fields: [visitId], references: [id])
  session  CafeCashSession? @relation(fields: [sessionId], references: [id])
  items    CafeOrderItem[]

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@index([visitId])
  @@map("orders")
  @@schema("daily_cafe")
}

model CafeOrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  variantId String  @map("variant_id") @db.Uuid
  nameEn    String  @map("name_en")
  nameAr    String  @map("name_ar")
  qty       Decimal @default(1) @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  /// Modifier selections captured at sale time.
  modifiers Json?
  /// Ingredient cost frozen at the moment of sale, so historical margin
  /// reports stay accurate when supplier prices change later.
  costSnapshot Decimal @default(0) @map("cost_snapshot") @db.Decimal(14, 4)
  notes     String?
  sortOrder Int     @default(0) @map("sort_order")

  order   CafeOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant CafeProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
  @@schema("daily_cafe")
}

/// Cashier shift and cash-drawer reconciliation.
model CafeCashSession {
  id            String    @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  openedBy      String    @map("opened_by") @db.Uuid
  closedBy      String?   @map("closed_by") @db.Uuid
  openingFloat  Decimal   @default(0) @map("opening_float") @db.Decimal(14, 2)
  expectedCash  Decimal   @default(0) @map("expected_cash") @db.Decimal(14, 2)
  closingCount  Decimal?  @map("closing_count") @db.Decimal(14, 2)
  variance      Decimal?  @db.Decimal(14, 2)
  status        String    @default("open")
  openedAt      DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  notes         String?

  orders CafeOrder[]

  @@index([branchId, status])
  @@map("cash_sessions")
  @@schema("daily_cafe")
}

/// Spoilage and breakage — depletes stock and shows up against profit.
model CafeWasteLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  partId         String   @map("part_id") @db.Uuid
  qty            Decimal  @db.Decimal(14, 4)
  unit           String
  reason         String
  cost           Decimal  @default(0) @db.Decimal(14, 4)
  recordedBy     String?  @map("recorded_by") @db.Uuid
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  notes          String?

  part Part @relation(fields: [partId], references: [id])

  @@index([branchId, recordedAt])
  @@map("waste_logs")
  @@schema("daily_cafe")
}
