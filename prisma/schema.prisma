  workOrder WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items     QualityCheckItem[]

  @@map("quality_checks")
  @@schema("promotors")
}

model QualityCheckItem {
  id             String  @id @default(uuid()) @db.Uuid
  qualityCheckId String  @map("quality_check_id") @db.Uuid
  labelEn        String  @map("label_en")
  labelAr        String  @map("label_ar")
  passed         Boolean?

  qualityCheck QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@map("quality_check_items")
  @@schema("promotors")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  code            String
  nameEn          String    @map("name_en")
  nameAr          String    @map("name_ar")
  laborPrice      Decimal   @map("labor_price") @db.Decimal(14, 2)
  durationMinutes Int       @map("duration_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
