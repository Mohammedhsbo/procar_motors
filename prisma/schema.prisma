  rollId     String   @map("roll_id") @db.Uuid
  jobItemId  String   @map("job_item_id") @db.Uuid
  metersUsed Decimal  @map("meters_used") @db.Decimal(10, 3)
  wasteM     Decimal  @default(0) @map("waste_m") @db.Decimal(10, 3)
  recordedBy String?  @map("recorded_by") @db.Uuid
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

