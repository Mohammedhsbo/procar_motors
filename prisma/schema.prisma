model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  rate           Decimal   @db.Decimal(5, 2)
  isDefault      Boolean   @default(false) @map("is_default")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("tax_rates")
  @@schema("finance")
}

model Quotation {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  visitId           String          @map("visit_id") @db.Uuid
  jobTicketId       String?         @map("job_ticket_id") @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  vehicleId         String?         @map("vehicle_id") @db.Uuid
  number            String
  version           Int             @default(1)
  parentQuotationId String?         @map("parent_quotation_id") @db.Uuid
  status            QuotationStatus @default(draft)
  subtotal          Decimal         @default(0) @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(14, 2)
  tax               Decimal         @default(0) @db.Decimal(14, 2)
  total             Decimal         @default(0) @db.Decimal(14, 2)
  estimatedMinutes  Int?            @map("estimated_minutes")
  validUntil        DateTime?       @map("valid_until") @db.Timestamptz(6)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(6)
  decidedAt         DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid

  visit      VehicleVisit         @relation(fields: [visitId], references: [id])
  jobTicket  JobTicket?           @relation(fields: [jobTicketId], references: [id])
  customer   Customer             @relation(fields: [customerId], references: [id])
  parent     Quotation?           @relation("QuoteVersions", fields: [parentQuotationId], references: [id])
  children   Quotation[]          @relation("QuoteVersions")
  items      QuotationItem[]
  approvals  QuotationApproval[]
  invoices   Invoice[]

  @@unique([organizationId, number, version])
  @@map("quotations")
  @@schema("finance")
}

model QuotationItem {
  id          String            @id @default(uuid()) @db.Uuid
  quotationId String            @map("quotation_id") @db.Uuid
  kind        QuotationItemKind
  partId      String?           @map("part_id") @db.Uuid
  serviceId   String?           @map("service_id") @db.Uuid
  nameEn      String            @map("name_en")
  nameAr      String            @map("name_ar")
  qty         Decimal           @db.Decimal(14, 3)
  unitPrice   Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal           @map("line_total") @db.Decimal(14, 2)
  sortOrder   Int               @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
