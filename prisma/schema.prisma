model TaxRate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  rate           Decimal   @db.Decimal(5, 2)
  isDefault      Boolean   @default(false) @map("is_default")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("tax_rates")
  @@schema("finance")
}

model Quotation {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  branchId          String          @map("branch_id") @db.Uuid
  visitId           String          @map("visit_id") @db.Uuid
  jobTicketId       String?         @map("job_ticket_id") @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  vehicleId         String?         @map("vehicle_id") @db.Uuid
  number            String
  version           Int             @default(1)
  parentQuotationId String?         @map("parent_quotation_id") @db.Uuid
  status            QuotationStatus @default(draft)
  subtotal          Decimal         @default(0) @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(14, 2)
  tax               Decimal         @default(0) @db.Decimal(14, 2)
  total             Decimal         @default(0) @db.Decimal(14, 2)
  estimatedMinutes  Int?            @map("estimated_minutes")
  validUntil        DateTime?       @map("valid_until") @db.Timestamptz(6)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(6)
  decidedAt         DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid

  visit      VehicleVisit         @relation(fields: [visitId], references: [id])
  jobTicket  JobTicket?           @relation(fields: [jobTicketId], references: [id])
  customer   Customer             @relation(fields: [customerId], references: [id])
  parent     Quotation?           @relation("QuoteVersions", fields: [parentQuotationId], references: [id])
  children   Quotation[]          @relation("QuoteVersions")
  items      QuotationItem[]
  approvals  QuotationApproval[]
  invoices   Invoice[]

  @@unique([organizationId, number, version])
  @@map("quotations")
  @@schema("finance")
}

model QuotationItem {
  id          String            @id @default(uuid()) @db.Uuid
  quotationId String            @map("quotation_id") @db.Uuid
  kind        QuotationItemKind
  partId      String?           @map("part_id") @db.Uuid
  serviceId   String?           @map("service_id") @db.Uuid
  nameEn      String            @map("name_en")
  nameAr      String            @map("name_ar")
  qty         Decimal           @db.Decimal(14, 3)
  unitPrice   Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal           @map("line_total") @db.Decimal(14, 2)
  sortOrder   Int               @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
  @@schema("finance")
}

model QuotationApproval {
  id          String            @id @default(uuid()) @db.Uuid
  quotationId String            @map("quotation_id") @db.Uuid
  actorType   ApprovalActorType @map("actor_type")
  actorId     String?           @map("actor_id") @db.Uuid
  decision    ApprovalDecision
  comment     String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_approvals")
  @@schema("finance")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  visitId        String?       @map("visit_id") @db.Uuid
  jobTicketId    String?       @map("job_ticket_id") @db.Uuid
  workOrderId    String?       @map("work_order_id") @db.Uuid
  quotationId    String?       @map("quotation_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  number         String
  status         InvoiceStatus @default(draft)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  tax            Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt          DateTime?     @map("due_at") @db.Timestamptz(6)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?       @map("cancel_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?       @map("created_by") @db.Uuid

  visit     VehicleVisit? @relation(fields: [visitId], references: [id])
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id])
  quotation Quotation?    @relation(fields: [quotationId], references: [id])
  customer  Customer      @relation(fields: [customerId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  refunds   Refund[]

  @@unique([organizationId, number])
  @@index([branchId, status])
  @@map("invoices")
  @@schema("finance")
}

model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  kind      String
  nameEn    String  @map("name_en")
  nameAr    String  @map("name_ar")
  qty       Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sortOrder Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
  @@schema("finance")
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  invoiceId  String        @map("invoice_id") @db.Uuid
  branchId   String        @map("branch_id") @db.Uuid
  number     String
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  status     PaymentStatus @default(pending)
  receivedBy String?       @map("received_by") @db.Uuid
  paidAt     DateTime?     @map("paid_at") @db.Timestamptz(6)
  reference  String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  refunds Refund[]

  @@unique([branchId, number])
  @@index([paidAt])
  @@map("payments")
  @@schema("finance")
}

model Refund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  reason     String?
  approvedBy String?  @map("approved_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("refunds")
  @@schema("finance")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  category    String
  amount      Decimal  @db.Decimal(14, 2)
  expenseDate DateTime @map("expense_date") @db.Date
  status      String   @default("confirmed")
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("expenses")
  @@schema("finance")
}

// ─────────────────────────────────────────────
// OPS
// ─────────────────────────────────────────────

model StoredFile {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  key            String
  filename       String
  mime           String
  size           Int
  status         String    @default("pending")
  uploadedBy     String?   @map("uploaded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("files")
  @@schema("ops")
}

model Attachment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  entityType     String          @map("entity_type")
  entityId       String          @map("entity_id") @db.Uuid
  fileKey        String          @map("file_key")
  mime           String
  size           Int
  kind           AttachmentKind
  phase          AttachmentPhase @default(other)
  uploadedBy     String?         @map("uploaded_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("attachments")
  @@schema("ops")
}

model PortalFeedback {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  visitId        String?  @map("visit_id") @db.Uuid
  rating         Int?
  comment        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([customerId, createdAt])
  @@index([organizationId, createdAt])
  @@map("portal_feedback")
  @@schema("ops")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  category   String
  titleEn    String    @map("title_en")
  titleAr    String    @map("title_ar")
  bodyEn     String?   @map("body_en")
  bodyAr     String?   @map("body_ar")
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("ops")
}

model NotificationPreference {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  channel  String
  eventKey String  @map("event_key")
  enabled  Boolean @default(true)

  @@unique([userId, channel, eventKey])
  @@map("notification_preferences")
  @@schema("ops")
}

model OpsTask {
  id         String    @id @default(uuid()) @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  assigneeId String?   @map("assignee_id") @db.Uuid
  type       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  title      String
  priority   Priority  @default(normal)
  dueAt      DateTime? @map("due_at") @db.Timestamptz(6)
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tasks")
  @@schema("ops")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  userId         String?  @map("user_id") @db.Uuid
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
  @@schema("ops")
}

model SyncOperation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  clientId       String       @map("client_id")
  operationId    String       @map("operation_id")
  entityType     String       @map("entity_type")
  action         String       @default("create")
  payload        Json
  status         SyncOpStatus @default(pending)
  conflictInfo   Json?        @map("conflict_info")
  result         Json?
  serverEntityId String?      @map("server_entity_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@unique([clientId, operationId])
  @@index([organizationId, operationId])
  @@index([actorId, createdAt])
  @@map("sync_operations")
  @@schema("ops")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  retryCount  Int          @default(0) @map("retry_count")

  @@index([status, createdAt])
  @@map("outbox_events")
  @@schema("ops")
}

// ─────────────────────────────────────────────
// ECOSYSTEM STUBS
// ─────────────────────────────────────────────

model UxpProfile {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  loyaltyPts Int      @default(0) @map("loyalty_pts")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("profiles")
  @@schema("uxp")
}

model TireProduct {
  id        String   @id @default(uuid()) @db.Uuid
  sku       String   @unique
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  size      String?
  brand     String?
  partId    String?  @map("part_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders TireOrder[]

  @@map("products")
  @@schema("tireszone")
}

model TireOrder {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  vehicleId   String?  @map("vehicle_id") @db.Uuid
  visitId     String?  @map("visit_id") @db.Uuid
  workOrderId String?  @map("work_order_id") @db.Uuid
  qty         Int      @default(1)
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product   TireProduct  @relation(fields: [productId], references: [id])
  customer  Customer?    @relation(fields: [customerId], references: [id])
  vehicle   Vehicle?     @relation(fields: [vehicleId], references: [id])
  visit     VehicleVisit? @relation(fields: [visitId], references: [id])
  workOrder WorkOrder?   @relation(fields: [workOrderId], references: [id])

  @@index([visitId])
  @@index([customerId])
  @@index([workOrderId])
  @@map("orders")
  @@schema("tireszone")
}

model CafeOrder {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  visitId    String?  @map("visit_id") @db.Uuid
  employeeId String?  @map("employee_id") @db.Uuid
  total      Decimal  @default(0) @db.Decimal(14, 2)
  status     String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer?     @relation(fields: [customerId], references: [id])
  visit    VehicleVisit? @relation(fields: [visitId], references: [id])

  @@map("orders")
  @@schema("daily_cafe")
}
