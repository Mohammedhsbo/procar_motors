  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("services")
  @@schema("promotors")
}

model Warranty {
  id                String    @id @default(uuid()) @db.Uuid
  vehicleId         String    @map("vehicle_id") @db.Uuid
  workOrderId       String?   @map("work_order_id") @db.Uuid
  type              String
  description       String?
  validUntil        DateTime? @map("valid_until") @db.Date
  validUntilMileage Int?      @map("valid_until_mileage")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("warranties")
  @@schema("promotors")
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch       Branch                @relation(fields: [branchId], references: [id])
  balances     StockBalance[]
  transactions InventoryTransaction[]
  reservations StockReservation[]
  alerts       StockAlert[]

  @@unique([branchId, code])
  @@map("warehouses")
  @@schema("inventory")
}

model PartCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  nameEn         String  @map("name_en")
  nameAr         String  @map("name_ar")
  parentId       String? @map("parent_id") @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id])
  parent       PartCategory? @relation("CatTree", fields: [parentId], references: [id])
  children     PartCategory[] @relation("CatTree")
  parts        Part[]

  @@map("part_categories")
  @@schema("inventory")
}

model Part {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sku            String
  barcode        String?
  oemNumber      String?   @map("oem_number")
  nameEn         String    @map("name_en")
  nameAr         String    @map("name_ar")
  categoryId     String?   @map("category_id") @db.Uuid
  brand          String?
  unit           String    @default("pcs")
  costPrice      Decimal   @map("cost_price") @db.Decimal(14, 2)
  sellPrice      Decimal   @map("sell_price") @db.Decimal(14, 2)
  minStock       Int       @default(0) @map("min_stock")
  maxStock       Int?      @map("max_stock")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id])
  category     PartCategory?          @relation(fields: [categoryId], references: [id])
  balances     StockBalance[]
  transactions InventoryTransaction[]
  reservations StockReservation[]
  alerts       StockAlert[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@map("parts")
  @@schema("inventory")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  partId      String   @map("part_id") @db.Uuid
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  reserved    Decimal  @default(0) @db.Decimal(14, 3)
  binLocation String?  @map("bin_location")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  part      Part      @relation(fields: [partId], references: [id])

  @@unique([warehouseId, partId])
  @@map("stock_balances")
  @@schema("inventory")
}

model InventoryTransaction {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  warehouseId    String           @map("warehouse_id") @db.Uuid
  partId         String           @map("part_id") @db.Uuid
  type           InventoryTxnType
  qty            Decimal          @db.Decimal(14, 3)
  unitCost       Decimal?         @map("unit_cost") @db.Decimal(14, 2)
  referenceType  String?          @map("reference_type")
  referenceId    String?          @map("reference_id") @db.Uuid
  notes          String?
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  part      Part      @relation(fields: [partId], references: [id])

  @@index([partId, createdAt])
  @@index([branchId, createdAt])
  @@map("inventory_transactions")
  @@schema("inventory")
}

model StockReservation {
  id           String            @id @default(uuid()) @db.Uuid
  warehouseId  String            @map("warehouse_id") @db.Uuid
  partId       String            @map("part_id") @db.Uuid
  workOrderId  String            @map("work_order_id") @db.Uuid
  visitId      String            @map("visit_id") @db.Uuid
  qty          Decimal           @db.Decimal(14, 3)
  qtyConsumed  Decimal           @default(0) @map("qty_consumed") @db.Decimal(14, 3)
  status       ReservationStatus @default(active)
  createdBy    String?           @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  part      Part         @relation(fields: [partId], references: [id])
  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  visit     VehicleVisit @relation(fields: [visitId], references: [id])

  @@map("stock_reservations")
  @@schema("inventory")
}

model StockAlert {
  id          String           @id @default(uuid()) @db.Uuid
  branchId    String           @map("branch_id") @db.Uuid
  warehouseId String           @map("warehouse_id") @db.Uuid
  partId      String           @map("part_id") @db.Uuid
  level       StockAlertLevel
  status      StockAlertStatus @default(open)
  openedAt    DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime?        @map("closed_at") @db.Timestamptz(6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  part      Part      @relation(fields: [partId], references: [id])

  @@map("stock_alerts")
  @@schema("inventory")
}

