  @@index([jobId])
  @@map("job_items")
  @@schema("uxp")
}

/// Per-panel coverage state, drives the interactive vehicle map.
model UxbJobZone {
  id        String  @id @default(uuid()) @db.Uuid
  jobId     String  @map("job_id") @db.Uuid
  panelCode String  @map("panel_code")
