}

/// Pricing dimension — a Corolla and a Land Cruiser are not the same job.
model UxbSizeClass {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  multiplier     Decimal  @default(1) @db.Decimal(6, 3)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prices UxbServicePrice[]
  jobs   UxbJob[]

  @@unique([organizationId, code])
  @@map("vehicle_size_classes")
  @@schema("uxp")
}

model UxbService {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  code           String
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  description    String?
  basePrice      Decimal  @default(0) @map("base_price") @db.Decimal(14, 2)
  durationMin    Int      @default(60) @map("duration_min")
  warrantyMonths Int?     @map("warranty_months")
  /// Consumable this service draws from, e.g. a film roll in inventory.
  materialPartId String?  @map("material_part_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category UxbServiceCategory @relation(fields: [categoryId], references: [id])
  prices   UxbServicePrice[]
  jobItems UxbJobItem[]

  @@unique([organizationId, code])
  @@index([categoryId])
  @@map("services")
  @@schema("uxp")
}

model UxbServicePrice {
  id          String  @id @default(uuid()) @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  sizeClassId String  @map("size_class_id") @db.Uuid
  price       Decimal @db.Decimal(14, 2)

  service   UxbService   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sizeClass UxbSizeClass @relation(fields: [sizeClassId], references: [id], onDelete: Cascade)

  @@unique([serviceId, sizeClassId])
  @@map("service_prices")
  @@schema("uxp")
}

model UxbJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  number         String
  customerId     String    @map("customer_id") @db.Uuid
  vehicleId      String    @map("vehicle_id") @db.Uuid
  sizeClassId    String?   @map("size_class_id") @db.Uuid
  /// reception | inspection | in_progress | quality | ready | delivered | cancelled
  stage          String    @default("reception")
  /// Set when the job came from a Pro Motors workshop visit.
  visitId        String?   @map("visit_id") @db.Uuid
  advisorId      String?   @map("advisor_id") @db.Uuid
  odometer       Int?
  complaint      String?
  notes          String?
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  discount       Decimal   @default(0) @db.Decimal(14, 2)
  tax            Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  invoiceId      String?   @map("invoice_id") @db.Uuid
  promisedAt     DateTime? @map("promised_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer            @relation(fields: [customerId], references: [id])
  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id])
  visit     VehicleVisit?       @relation(fields: [visitId], references: [id])
  sizeClass UxbSizeClass?       @relation(fields: [sizeClassId], references: [id])
  items     UxbJobItem[]
  zones     UxbJobZone[]
  readings  UxbPaintReading[]

  @@unique([organizationId, number])
  @@index([branchId, stage])
  @@index([customerId])
  @@index([vehicleId])
  @@index([visitId])
  @@map("jobs")
  @@schema("uxp")
}

model UxbJobItem {
  id           String   @id @default(uuid()) @db.Uuid
  jobId        String   @map("job_id") @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  /// Panel or area this line covers, e.g. "hood", "front_door_right".
  zone         String?
  areaSqm      Decimal? @map("area_sqm") @db.Decimal(10, 3)
  qty          Decimal  @default(1) @db.Decimal(14, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount     Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(14, 2)
  technicianId String?  @map("technician_id") @db.Uuid
  status       String   @default("pending")
  sortOrder    Int      @default(0) @map("sort_order")

  job         UxbJob               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service     UxbService           @relation(fields: [serviceId], references: [id])
